<style>
.catalog{position:fixed;inset:129px 0 0;background:var(--background);color:var(--offwhite);display:flex;flex-direction:column;padding:24px 40px;gap:16px;z-index:20;font-size:13px;min-width:760px}
.catalog h1{font-size:26px;margin:0}.catalog p{margin:5px 0;color:var(--lightgray);line-height:1.5}
.catalog header,.catalog .toolbar,.catalog footer,.catalog .tabs{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.catalog header{justify-content:space-between}
.catalog button,.catalog select,.catalog input[type=search]{font:inherit;color:var(--offwhite);background:var(--background-light);border:1px solid #526071;border-radius:5px;padding:10px 14px}
.catalog button{cursor:pointer}.catalog button:hover{border-color:var(--offwhite)}.catalog button:disabled{opacity:.45;cursor:default}.catalog button.primary,.catalog .tabs .active{background:var(--blue);border-color:var(--blue)}
.catalog .tabs{border-bottom:1px solid var(--darkgray);padding-bottom:12px}.catalog .status{background:var(--background-note);padding:12px 16px;border-radius:5px;line-height:1.5}.catalog .error{background:var(--background-warning);color:#ffc48a}.catalog .prompt{border:1px solid var(--blue)}
.catalog .scroll{overflow:auto;flex:1;min-height:100px;border:1px solid var(--darkgray);border-radius:5px}.catalog table{width:100%;border-collapse:collapse;text-align:left}.catalog th{position:sticky;top:0;background:var(--background-light);z-index:1;color:var(--lightgray);font-weight:600}.catalog th,.catalog td{padding:11px 14px;border-bottom:1px solid var(--darkgray);vertical-align:top}.catalog td small{display:block;color:var(--gray);margin-top:4px;max-width:380px}.catalog .new{color:var(--green)}.catalog .muted{color:var(--gray)}.catalog details{margin-top:6px}.catalog summary{cursor:pointer;color:var(--lightgray)}.catalog .issues{max-height:110px;overflow:auto;font-size:12px}.catalog footer{justify-content:space-between}.catalog input[type=checkbox]{accent-color:var(--blue);width:16px;height:16px}.catalog select{max-width:210px}.catalog .grow{flex:1}
@media(max-height:720px){.catalog{gap:10px;padding:16px 28px}.catalog th,.catalog td{padding:8px 12px}.catalog p{font-size:12px}}
</style>
<div class="catalog" aria-label="Unit and Mod Manager">
<header><div><h1>Unit &amp; Mod Manager</h1><p>Bring installed DCS units, saved payload presets and liveries into Olympus.</p></div><button onclick="signal('onCatalogAction',{action:'close'})" <%= catalog.busy?'disabled':'' %>>Back to Manager</button></header>
<div class="toolbar"><label>DCS instance <select aria-label="DCS instance" onchange="signal('onCatalogAction',{action:'instance',params:this.value})" <%= catalog.busy?'disabled':'' %>><% for(const i of catalog.instances){ %><option value="<%= i.folder %>" <%= i.folder===catalog.folder?'selected':'' %>><%= i.name %></option><% } %></select></label><span class="grow muted"><%= catalog.root || 'DCS installation folder not selected' %></span><button onclick="signal('onCatalogAction',{action:'path'})" <%= catalog.busy?'disabled':'' %>>Locate DCS</button></div>
<div class="tabs"><button class="<%= catalog.source==='mod'?'active':'' %>" onclick="signal('onCatalogAction',{action:'source',params:'mod'})" <%= catalog.busy?'disabled':'' %>>Installed mods</button><button class="<%= catalog.source==='dcs'?'active':'' %>" onclick="signal('onCatalogAction',{action:'source',params:'dcs'})" <%= catalog.busy?'disabled':'' %>>DCS units &amp; updates</button><span class="grow"></span><button class="primary" onclick="signal('onCatalogAction',{action:'scan'})" <%= catalog.busy||!catalog.folder?'disabled':'' %>><%= catalog.busy?'Working…':'Scan for new units & mods' %></button></div>
<% if(catalog.prompt){ %><div class="status prompt"><strong>Found <%= catalog.prompt.newCount %> new models from your installed DCS content.</strong><p><%= catalog.prompt.ids.length %> unit records have new models or payload/livery metadata. Would you like to integrate them?</p><button class="primary" onclick="signal('onCatalogAction',{action:'yes'})" <%= catalog.busy?'disabled':'' %>>Yes</button> <button onclick="signal('onCatalogAction',{action:'no'})" <%= catalog.busy?'disabled':'' %>>No</button> <button onclick="signal('onCatalogAction',{action:'later'})" <%= catalog.busy?'disabled':'' %>>Later</button><small> No dismisses these versions. Later asks again next time Manager opens.</small></div><% } %>
<% if(catalog.message){ %><div class="status" role="status"><%= catalog.message %></div><% } %>
<% if(catalog.error){ %><div class="status error" role="alert"><%= catalog.error %></div><% } %>
<% if(catalog.source==='mod'){ %><p>Install mod files in DCS first. Customize aircraft payloads in Mission Editor and save them as presets, then scan here. Ships and ground units use their DCS-defined weapons.</p><% } else { %><p>Manager checks on startup. Standard DCS definitions stay read-only here; import adds available units and metadata while preserving existing Olympus entries.</p><% } %>
<% const rows=(catalog.result?.inventory||[]).filter(u=>u.source===catalog.source); %>
<div class="toolbar"><input type="search" aria-label="Search units" placeholder="Search name, category or package…" oninput="const q=this.value.toLowerCase();this.closest('.catalog').querySelectorAll('tbody tr').forEach(r=>r.hidden=!r.dataset.search.includes(q))"><span class="muted"><%= rows.length %> units · DCS <%= catalog.result?.version || 'not scanned' %><%= catalog.result?.snapshotUsable?' · Database verified':' · Complete catalog pending' %></span></div>
<div class="scroll"><table><thead><tr><th><input type="checkbox" aria-label="Select visible units" <%= catalog.busy?'disabled':'' %> onchange="this.closest('table').querySelectorAll('tbody tr:not([hidden]) input:not(:disabled)').forEach(c=>c.checked=this.checked)"></th><th>Unit / package</th><th>Category</th><th>Payloads / liveries</th><th>Status</th></tr></thead><tbody>
<% for(const u of rows){ %><tr data-search="<%= [u.id,u.displayName,u.category,u.package].join(' ').toLowerCase() %>"><td><input type="checkbox" class="unit-choice" aria-label="Select <%= u.id %>" value="<%= u.id %>" <%= u.conflict||catalog.busy?'disabled':'' %>></td><td><strong><%= u.displayName %></strong><small><%= u.id %> · <%= u.package %></small></td><td><%= ({GroundUnit:'Ground unit',NavyUnit:'Ship'})[u.category]||u.category %><small><%= u.era||'' %></small></td><td><%= u.presets.length %> presets · <%= Object.keys(u.liveries).length %> liveries<% if(u.presets.length){ %><details><summary>View presets</summary><small><%= u.presets.map(p=>p.name).join(' · ') %></small></details><% } %></td><td class="<%= u.status==='New unit'?'new':'' %>"><%= u.status %><% if(u.issues.length){ %><details><summary><%= u.issues.length %> notes</summary><small><%= u.issues.join(' ') %></small></details><% } %></td></tr><% } %>
<% if(!rows.length){ %><tr><td colspan="5">No units to show yet. Select your DCS folder and scan. For compiled units, start DCS once with the catalog bridge installed, then reopen Manager.</td></tr><% } %>
</tbody></table></div>
<% if(catalog.result?.issues.length){ %><details class="issues"><summary>Scan notes (<%= catalog.result.issues.length %>)</summary><% for(const issue of catalog.result.issues){ %><p><%= issue %></p><% } %></details><% } %>
<footer><div><button onclick="signal('onCatalogAction',{action:'openMods'})" <%= !catalog.folder?'disabled':'' %>>Open mods folder</button> <button onclick="signal('onCatalogAction',{action:'openBackups'})" <%= !catalog.folder?'disabled':'' %>>Backups</button> <button onclick="signal('onCatalogAction',{action:'restore'})" <%= catalog.busy?'disabled':'' %>>Restore last import</button></div><button class="primary" onclick="signal('onCatalogAction',{action:'import',params:Array.from(this.closest('.catalog').querySelectorAll('.unit-choice:checked')).map(c=>c.value)})" <%= catalog.busy||!rows.length?'disabled':'' %>>Import selected units</button></footer>
</div>
